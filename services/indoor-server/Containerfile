# Indoor gateway for better-maps (authenticating front of the prebuilt venue data) and the importer that builds
# that data. One image, two binaries: the gateway is the entrypoint, compose.yaml runs indoor-import for the import.
#
# Build:  podman build -t bettermaps-indoor-gateway -f Containerfile .
# Run:    see compose.yaml and scripts/run.sh

# --- build stage -------------------------------------------------------------------------------
FROM docker.io/library/golang:1.24 AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/indoor-gateway ./cmd/indoor-gateway && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/indoor-import ./cmd/indoor-import

# --- runtime stage -----------------------------------------------------------------------------
# distroless/static runs as an unprivileged user (uid 65532) and contains no shell.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/indoor-gateway /usr/local/bin/indoor-gateway
COPY --from=build /out/indoor-import /usr/local/bin/indoor-import
USER 65532:65532
ENV INDOOR_LISTEN=:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/indoor-gateway"]
