# TraFF server for better-maps.
#
# Build:  podman build -t traff-server -f Containerfile .
# Run:    podman run --rm -p 8080:8080 traff-server

# --- build stage -------------------------------------------------------------------------------
FROM docker.io/library/golang:1.24 AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
# Static binary without cgo; tzdata is embedded via time/tzdata.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/traff-server ./cmd/traff-server

# --- runtime stage -----------------------------------------------------------------------------
# distroless/static contains CA certificates and runs as an unprivileged user (uid 65532).
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/traff-server /usr/local/bin/traff-server
USER 65532:65532
ENV TRAFF_LISTEN=:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/traff-server"]
