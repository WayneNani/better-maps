# Imagery gateway for better-maps (authenticating, caching front of MapProxy).
#
# Build:  podman build -t bettermaps-imagery-gateway -f Containerfile .
# Run:    see compose.yaml and scripts/run.sh

# --- build stage -------------------------------------------------------------------------------
FROM docker.io/library/golang:1.24 AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/imagery-gateway ./cmd/imagery-gateway

# --- runtime stage -----------------------------------------------------------------------------
# distroless/static runs as an unprivileged user (uid 65532) and contains no shell.
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/imagery-gateway /usr/local/bin/imagery-gateway
USER 65532:65532
ENV IMAGERY_LISTEN=:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/imagery-gateway"]
