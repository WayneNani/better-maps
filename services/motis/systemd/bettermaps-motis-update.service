# Weekly MOTIS data update (user service). Install, see README "Wöchentliches Update".
[Unit]
Description=better-maps MOTIS: fetch timetable/OSM data and re-import
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust the path to your checkout. Environment variables from scripts/common.sh can be set here.
Environment=MOTIS_PROFILE=berlin
Environment=MOTIS_PORT=18090
ExecStart=%h/Projects/better-maps/services/motis/scripts/update.sh
Nice=10
IOSchedulingClass=idle
