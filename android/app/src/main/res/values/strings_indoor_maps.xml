<!-- better-maps: indoor maps of airports, stations and malls (settings, level switcher, details). -->
<resources>
  <string name="indoor_maps_server_title">Indoor maps server</string>
  <string name="indoor_maps_info">Indoor maps show rooms, shops, gates, toilets and other places on the different levels of large airports, stations and malls, from OpenStreetMap data on your own indoor server (services/indoor-server). When you zoom in on such a place (zoom 16 and closer), the venues around the visible area are requested from the server; they are cached on the device.</string>
  <string name="indoor_maps_enabled">Show indoor maps</string>
  <string name="indoor_maps_url">Server address</string>
  <string name="indoor_maps_url_hint">e.g. https://indoor.example.org</string>
  <string name="indoor_maps_token">Access token</string>
  <string name="indoor_maps_token_hint">The token of this device from scripts/new-token.sh. Leave empty to keep the stored token.</string>
  <string name="indoor_maps_needs_server">Enter the server address and the access token as well</string>
  <string name="indoor_maps_off">Off</string>
