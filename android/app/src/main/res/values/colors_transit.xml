  <color name="transit_alt_area">#140F766E</color>
  <color name="transit_alt_area_stroke">#470F766E</color>
  <!-- One departure ("chip"). -->
  <color name="transit_alt_chip">#FFFFFFFF</color>
  <color name="transit_alt_chip_missed">#FFF3F5F5</color>
  <color name="transit_alt_chip_stroke">#33000000</color>
  <color name="transit_alt_ok">#FF2E6B30</color>
