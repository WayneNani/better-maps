<?xml version="1.0" encoding="utf-8"?>
<!-- better-maps: connections of the online public transport planner (list and detail view). A sheet that can be
     dragged between collapsed (handle and summary), half and expanded, see OnlineTransitPanel. -->
<app.organicmaps.transit.ui.TransitSheetLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/online_transit_panel"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:visibility="gone"
  tools:visibility="visible">

  <!-- Tap: collapse or open to half; drag: resize. -->
  <FrameLayout
    android:id="@+id/transit_handle"
    android:layout_width="match_parent"
    android:layout_height="16dp"
    android:background="?selectableItemBackground"
    android:contentDescription="@string/transit_sheet_handle">

    <com.google.android.material.imageview.ShapeableImageView
      android:layout_width="32dp"
      android:layout_height="4dp"
      android:layout_gravity="center"
      android:importantForAccessibility="no"
      app:srcCompat="@drawable/bottom_sheet_handle"
      app:tint="?colorControlHighlight" />
  </FrameLayout>

  <!-- Collapsed sheet: one line, e.g. "11:44 – 11:57 · 13 min · 1 transfer". -->
  <LinearLayout
    android:id="@+id/transit_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?selectableItemBackground"
    android:contentDescription="@string/transit_sheet_expand"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_base"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/transit_summary_text"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAppearance="@style/MwmTextAppearance.Body2"
      android:textStyle="bold"
      tools:text="11:44 – 11:57 · 13 min · 1 transfer" />

    <com.google.android.material.imageview.ShapeableImageView
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:layout_marginStart="@dimen/margin_half"
      android:importantForAccessibility="no"
      app:srcCompat="@drawable/ic_transit_expand" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/transit_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_half"
    android:paddingEnd="@dimen/margin_half">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_back"
      style="@style/Widget.Material3.Button.IconButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:contentDescription="@string/transit_back"
      android:visibility="gone"
      app:icon="@drawable/ic_transit_back"
      app:iconTint="?iconTint"
      tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_time"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="start|center_vertical"
      android:textAllCaps="false"
      app:icon="@drawable/ic_transit_schedule"
      tools:text="Depart now" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/transit_detail_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textAppearance="@style/MwmTextAppearance.Body2"
      android:textStyle="bold"
      android:visibility="gone"
      tools:text="17:29 – 17:46 · 17 min" />

    <!-- List or time grid, for the running search. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
      android:id="@+id/transit_view_toggle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:contentDescription="@string/transit_view_switch"
      app:selectionRequired="true"
      app:singleSelection="true">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/transit_view_list"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/transit_view_list"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        app:icon="@drawable/ic_transit_view_list"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?iconTint" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/transit_view_grid"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/transit_view_grid"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        app:icon="@drawable/ic_transit_view_grid"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?iconTint" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_saved_list"
      style="@style/Widget.Material3.Button.IconButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:contentDescription="@string/transit_saved_title"
      app:icon="@drawable/ic_transit_saved"
      app:iconTint="?iconTint" />

    <!-- Save the connection in the detail view; filled when saved. -->
    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_save"
      style="@style/Widget.Material3.Button.IconButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:contentDescription="@string/transit_save"
      android:visibility="gone"
      app:icon="@drawable/ic_transit_bookmark"
      tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_settings"
      style="@style/Widget.Material3.Button.IconButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:contentDescription="@string/transit_settings_open"
      app:icon="@drawable/ic_settings"
      app:iconTint="?iconTint" />
  </LinearLayout>

  <com.google.android.material.progressindicator.LinearProgressIndicator
    android:id="@+id/transit_progress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:indeterminate="true"
    android:visibility="gone"
    tools:visibility="visible" />

  <LinearLayout
    android:id="@+id/transit_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_base"
    android:paddingTop="@dimen/margin_half"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/transit_status_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@style/MwmTextAppearance.Body3"
      tools:text="@string/transit_error_network" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_retry"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/transit_retry" />
  </LinearLayout>

  <!-- Shown for a saved connection: its date or that it is over, and searching again. -->
  <LinearLayout
    android:id="@+id/transit_saved_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_half"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/transit_saved_text"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textAppearance="@style/MwmTextAppearance.Body3"
      tools:text="This connection is in the past (Sun, Oct 25, 2026)." />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_search_again"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/transit_search_again"
      android:textAllCaps="false" />
  </LinearLayout>

  <!-- Time grid: the axis stays, the columns scroll sideways. The height is set in code. -->
  <HorizontalScrollView
    android:id="@+id/transit_grid_scroll"
    android:layout_width="match_parent"
    android:layout_height="320dp"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="gone">

    <app.organicmaps.transit.ui.TimeGridView
      android:id="@+id/transit_grid"
      android:layout_width="wrap_content"
      android:layout_height="match_parent" />
  </HorizontalScrollView>

  <app.organicmaps.transit.ui.MaxHeightRecyclerView
    android:id="@+id/transit_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/transit_attribution"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="32dp"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_base"
    android:paddingBottom="@dimen/margin_quarter"
    android:textAppearance="@style/MwmTextAppearance.Body4"
    tools:text="Data: Transitous and sources" />
</app.organicmaps.transit.ui.TransitSheetLayout>
