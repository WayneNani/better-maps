<?xml version="1.0" encoding="utf-8"?>
<!-- better-maps: title of the online results section in the search list. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_half_double_plus"
  android:paddingEnd="@dimen/margin_half_double_plus"
  android:paddingTop="@dimen/margin_base"
  android:paddingBottom="@dimen/margin_quarter">

  <include
    layout="@layout/item_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginBottom="@dimen/margin_half" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/online_search_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAlignment="viewStart"
    android:textAppearance="@style/MwmTextAppearance.Body2"
    android:textColor="?colorSecondary"
    android:textStyle="bold"
    tools:text="Online results (Photon)" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/online_search_attribution"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAlignment="viewStart"
    android:textAppearance="@style/MwmTextAppearance.Body4"
    android:text="@string/online_search_attribution" />
</LinearLayout>
