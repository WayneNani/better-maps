<?xml version="1.0" encoding="utf-8"?>
<!-- better-maps: level switcher of the indoor map at the right map edge (IndoorController). -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/indoor_panel"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:gravity="end"
  android:orientation="vertical"
  android:visibility="gone"
  tools:visibility="visible">

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/indoor_level_card"
    android:layout_width="@dimen/indoor_level_button_size"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?appBackground"
    app:cardCornerRadius="@dimen/indoor_level_corner"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <ScrollView
      android:id="@+id/indoor_level_scroll"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fadeScrollbars="false"
      android:scrollbars="none">

      <LinearLayout
        android:id="@+id/indoor_levels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    </ScrollView>
  </com.google.android.material.card.MaterialCardView>

  <TextView
    android:id="@+id/indoor_attribution"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_quarter"
    android:background="@drawable/indoor_attribution_background"
    android:paddingHorizontal="4dp"
    android:paddingVertical="1dp"
    android:text="@string/indoor_attribution"
    android:textColor="?android:textColorPrimary"
    android:textSize="10sp" />
</LinearLayout>
