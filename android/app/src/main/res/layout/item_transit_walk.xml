<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="@dimen/margin_base"
  android:paddingEnd="@dimen/margin_base"
  android:paddingTop="@dimen/margin_quarter"
  android:paddingBottom="@dimen/margin_quarter">

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/walk_time"
    android:layout_width="64dp"
    android:layout_height="wrap_content"
    android:textAppearance="@style/MwmTextAppearance.Body3"
    tools:text="17:29" />

  <com.google.android.material.imageview.ShapeableImageView
    android:id="@+id/walk_icon"
    android:layout_width="20dp"
    android:layout_height="20dp"
    android:layout_marginEnd="@dimen/margin_half"
    app:srcCompat="@drawable/ic_transit_walk"
    app:tint="?iconTint" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/walk_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textAppearance="@style/MwmTextAppearance.Body3"
      tools:text="Walk 2 min (140 m)" />

    <com.google.android.material.textview.MaterialTextView
      android:id="@+id/walk_to"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAppearance="@style/MwmTextAppearance.Body4"
      tools:text="→ S+U Berlin Hauptbahnhof" />
  </LinearLayout>
</LinearLayout>
