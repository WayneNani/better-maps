<?xml version="1.0" encoding="utf-8"?>
<!-- better-maps: details of a tapped indoor room or place (IndoorController). -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_base"
  android:paddingTop="@dimen/margin_base"
  android:paddingEnd="@dimen/margin_base"
  android:paddingBottom="@dimen/margin_base">

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/indoor_feature_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAppearance="@style/MwmTextAppearance.Title"
    android:textIsSelectable="true"
    tools:text="Relay" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/indoor_feature_subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_quarter"
    android:textAppearance="@style/MwmTextAppearance.Body3"
    tools:text="Nr. B12 · Geschäft · Ebene 0 · Terminal 1 Flugsteig B" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/indoor_feature_details"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_half"
    android:autoLink="web"
    android:lineSpacingExtra="4dp"
    android:textAppearance="@style/MwmTextAppearance.Body2"
    android:visibility="gone"
    tools:text="Öffnungszeiten: Mo-Su 05:00-23:00\nRollstuhlgerecht"
    tools:visibility="visible" />

  <com.google.android.material.textview.MaterialTextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_base"
    android:text="@string/indoor_attribution"
    android:textAppearance="@style/MwmTextAppearance.Body4"
    android:textSize="11sp" />
</LinearLayout>
