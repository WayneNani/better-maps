<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_horizontal"
  android:orientation="vertical"
  android:paddingStart="@dimen/margin_base"
  android:paddingEnd="@dimen/margin_base"
  android:paddingTop="@dimen/margin_half">

  <com.google.android.material.button.MaterialButtonToggleGroup
    android:id="@+id/transit_time_mode"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:selectionRequired="true"
    app:singleSelection="true">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_time_departure"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/transit_departure" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/transit_time_arrival"
      style="@style/Widget.Material3.Button.OutlinedButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/transit_arrival" />
  </com.google.android.material.button.MaterialButtonToggleGroup>

  <com.google.android.material.chip.ChipGroup
    android:id="@+id/transit_time_day"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_half"
    app:selectionRequired="true"
    app:singleSelection="true">

    <com.google.android.material.chip.Chip
      android:id="@+id/transit_day_0"
      style="@style/Widget.Material3.Chip.Filter"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/transit_today" />

    <com.google.android.material.chip.Chip
      android:id="@+id/transit_day_1"
      style="@style/Widget.Material3.Chip.Filter"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/transit_tomorrow" />

    <com.google.android.material.chip.Chip
      android:id="@+id/transit_day_2"
      style="@style/Widget.Material3.Chip.Filter"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/transit_day_after_tomorrow" />
  </com.google.android.material.chip.ChipGroup>

  <TimePicker
    android:id="@+id/transit_time_picker"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:timePickerMode="spinner" />
</LinearLayout>
