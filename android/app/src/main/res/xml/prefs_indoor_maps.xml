<?xml version="1.0" encoding="utf-8"?>
<!-- better-maps: indoor maps server. Keys and values: app.organicmaps.settings.IndoorMapsSettings. -->
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <Preference
    android:key="indoor_maps_info"
    android:persistent="false"
    android:selectable="false"
    android:summary="@string/indoor_maps_info"
    app:iconSpaceReserved="false"
    app:singleLineTitle="false" />

  <SwitchPreferenceCompat
    android:key="indoor_maps_enabled"
    android:defaultValue="false"
    android:title="@string/indoor_maps_enabled"
    android:widgetLayout="@layout/preference_switch"
    app:iconSpaceReserved="false"
    app:singleLineTitle="false" />

  <EditTextPreference
    android:key="indoor_maps_url"
    android:title="@string/indoor_maps_url"
    android:dialogMessage="@string/indoor_maps_url_hint"
    app:iconSpaceReserved="false"
    app:singleLineTitle="false" />

  <EditTextPreference
    android:key="indoor_maps_token"
    android:persistent="false"
    android:title="@string/indoor_maps_token"
    android:dialogMessage="@string/indoor_maps_token_hint"
    app:iconSpaceReserved="false"
    app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
